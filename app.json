{
  "expo": {
    "name": "Hygiene Pets",
    "slug": "hygiene-pets",
    "version": "1.0.0",
    "scheme": "hygienepets",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Hygiene Pets uses the camera to scan campus hygiene station QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#19B6B2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
